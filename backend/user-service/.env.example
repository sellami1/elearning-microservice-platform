# User service runtime
USER_BACKEND_ENV=development
NODE_ENV=development
USER_BACKEND_PORT=8002
USER_BACKEND_URL=http://localhost:8002
PUBLIC_FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_EXPIRE_TIME=1d

# Database
MONGODB_URI=mongodb://localhost:27017/user_service_db

# Branding / email templates
APP_NAME=E-learning User Service

# SMTP (MailHog defaults for local testing)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_FROM=no-reply@local.test
EMAIL_USER=
EMAIL_PASSWORD=
